files:
  "/opt/elasticbeanstalk/hooks/appdeploy/enact/01_start_celery_worker.sh":
    mode: "000755"
    owner: "root"
    group: "root"
    content: |
      #!/bin/bash
      echo "Starting Celery worker..." | tee -a /var/log/celery.log
      cd /var/app/current
      source /var/app/venv/*/bin/activate
      nohup celery -A app.celery worker --loglevel=info > /var/log/celery_worker.log 2>&1 &

  "/opt/elasticbeanstalk/hooks/appdeploy/enact/02_start_celery_beat.sh":
    mode: "000755"
    owner: "root"
    group: "root"
    content: |
      #!/bin/bash
      echo "Starting Celery Beat..." | tee -a /var/log/celery.log
      cd /var/app/current
      source /var/app/venv/*/bin/activate
      nohup celery -A app.celery beat --loglevel=info > /var/log/celery_beat.log 2>&1 &

packages:
  yum:
    libxml2-devel: []
    libxslt-devel: []
    libjpeg-turbo-devel: []
    gcc: []
    gcc-c++: []
    python3-devel: []
    git: []

commands:
  01_upgrade_pip:
    command: "pip install --upgrade pip"
    ignoreErrors: false

  02_install_requirements:
    command: "pip install -r /var/app/current/requirements.txt"
    ignoreErrors: false

container_commands:
  01_restart_celery:
    command: |
      echo "Restarting Celery Services..." | tee -a /var/log/celery.log
      sleep 5
      pkill -f "celery worker"
      pkill -f "celery beat"
      systemctl restart celery || nohup celery -A app.celery worker --loglevel=info > /var/log/celery_worker.log 2>&1 &
      systemctl restart celerybeat || nohup celery -A app.celery beat --loglevel=info > /var/log/celery_beat.log 2>&1 &
